{
  "name": "openremote",
  "owner": {
    "name": "moreweb",
    "url": "https://moreweb.space"
  },
  "metadata": {
    "description": "OpenRemote's official plugins, each reviewed by moreweb before it is listed.",
    "version": "0.1.0"
  },
  "plugins": [
    {
      "name": "freebuff",
      "displayName": "Freebuff",
      "description": "Freebuff CLI as an OpenRemote harness: run Freebuff directly in OpenRemote with streaming, tools, and approvals.",
      "version": "0.1.0",
      "author": {
        "name": "moreweb",
        "url": "https://moreweb.space"
      },
      "homepage": "https://github.com/morewebs/OpenRemote-plugins/tree/master/freebuff",
      "license": "MIT",
      "category": "harness",
      "keywords": [
        "freebuff",
        "harness",
        "agent",
        "cli"
      ],
      "source": "./freebuff",
      "metadata": {
        "openremote": {
          "runtime": "process",
          "powers": [
            "run_programs",
            "network"
          ]
        }
      }
    },
    {
      "name": "dictation",
      "displayName": "Dictation",
      "description": "Speak into the composer: a microphone button that writes what you say at the cursor, through any OpenAI-compatible transcription service (OpenAI's own, another provider's, or a whisper server on your computer).",
      "version": "0.1.0",
      "author": {
        "name": "moreweb",
        "url": "https://moreweb.space"
      },
      "homepage": "https://github.com/morewebs/OpenRemote-plugins/tree/master/dictation",
      "license": "AGPL-3.0-only",
      "category": "productivity",
      "keywords": [
        "dictation",
        "voice",
        "speech-to-text",
        "whisper"
      ],
      "source": "./dictation",
      "metadata": {
        "openremote": {
          "runtime": "js",
          "powers": [
            "microphone",
            "network"
          ]
        }
      }
    }
  ]
}
