{
  "api": 1,
  "name": "freebuff",
  "version": "0.2.0",
  "description": "Freebuff CLI as an OpenRemote harness",
  "runtime": "process",
  "powers": ["run_programs", "network"],
  "harness": {
    "api": 1,
    "id": "freebuff",
    "name": "Freebuff",
    "driver": {
      "windows": "bin/windows-x64/freebuff-driver.exe",
      "default": "bin/freebuff-driver"
    },
    "args": [],
    "models": [
      {"model": "Glyph Cluster • high", "display_name": "Glyph Cluster • high", "detail": "1x · Preview model: prompts and outputs may be retained for training", "is_default": false},
      {"model": "Solar Pro 4", "display_name": "Solar Pro 4", "detail": "Upstage flagship", "note": "May use data for AI training", "is_default": false},
      {"model": "Solar Mini 4", "display_name": "Solar Mini 4", "detail": "Fast and light", "note": "May use data for AI training", "is_default": false},
      {"model": "MiMo v2.6 Flash Slow", "display_name": "MiMo v2.6 Flash Slow", "detail": "1x", "is_default": false},
      {"model": "DeepSeek V4.1 Flash Slow • high", "display_name": "DeepSeek V4.1 Flash Slow • high", "detail": "2x · Recommended · May use data for AI training", "is_default": false},
      {"model": "DeepSeek V4.1 Flash 10/17 • high", "display_name": "DeepSeek V4.1 Flash 10/17 • high", "detail": "3x · May use data for AI training", "is_default": true},
      {"model": "Muse Spark 1.3 • high", "display_name": "Muse Spark 1.3 • high", "detail": "Falls back when busy", "note": "Paid plan", "is_default": false},
      {"model": "GLM 5.3 Flash • high", "display_name": "GLM 5.3 Flash • high", "detail": "4x", "is_default": false},
      {"model": "MiMo v2.6 Flash Fast", "display_name": "MiMo v2.6 Flash Fast", "detail": "2x", "is_default": false},
      {"model": "GPT-6 Luna • high", "display_name": "GPT-6 Luna • high", "detail": "Strong all-around", "note": "Paid plan", "is_default": false},
      {"model": "DeepSeek V4.1 Flash Fast 10/17 • high", "display_name": "DeepSeek V4.1 Flash Fast 10/17 • high", "detail": "Fast", "note": "Paid plan", "is_default": false}
    ],
    "default_model": "DeepSeek V4.1 Flash 10/17 • high",
    "models_file": "models.json",
    "settings": "live"
  }
}
